# Copy to .env. Everything personal (addresses, printer, keys) lives here, never in the repo.
TZ=Asia/Jerusalem
SCHEDULE_CRON=0 8 * * *
COVERAGE_HOURS=24
REPORT_NAME=SITREP Israel
# true adds a source list to the PDF
PDF_SOURCES=false

OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Optional: follow-up searches, restricted to the domains in grounding/grounding-set.md
EXA_API_KEY=

# Audio briefing (any OpenRouter speech model)
TTS_ENABLED=true
TTS_MODEL=heygen/heygen-voice-1-turbo
TTS_VOICE=gareth
TTS_FORMAT=pcm

# Email. EMAIL_TO = people; EMAIL_GROUPS = group / mailing-list addresses (comma separated)
EMAIL_PROVIDER=resend
EMAIL_FROM=SITREP Israel <sitrep@example.com>
EMAIL_TO=
EMAIL_GROUPS=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Printing. hub = LAN-Print-Hub; cups = lp against a CUPS server
PRINT_ENABLED=false
# Weekdays to print on (sun,mon,tue,wed,thu,fri,sat), local TZ; empty or all = every day.
# Email, cloud folder and audio still run on every SCHEDULE_CRON run.
PRINT_DAYS=
PRINT_DRIVER=hub
PRINT_HUB_URL=http://print-server.lan:9190
PRINT_TARGET=
# one-sided or two-sided-long-edge
PRINT_SIDES=one-sided
PRINT_COPIES=1
CUPS_SERVER=
CUPS_QUEUE=

# Cloud folder: any rclone remote, e.g. gdrive:SITREP/Daily. Config file at data/rclone.conf
RCLONE_DEST=

# Newsletter: off | draft | send (send mails every subscriber)
BUTTONDOWN_MODE=off
BUTTONDOWN_API_KEY=

# Static website: each run commits reports/<date>/ to this GitHub repo; the host deploys on push. No database.
SITE_REPO=
# GitHub token with contents:write on SITE_REPO
SITE_TOKEN=
SITE_URL=https://example.com
# Writes a CNAME file for GitHub Pages; leave empty on Vercel and other hosts
SITE_DOMAIN=
